{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "build:product": "node ./build.mjs --native-product",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:product": "node --enable-source-maps ./dist-product/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@contentauth/c2pa-node": "0.9.1",
    "@contentauth/c2pa-types": "0.7.3",
    "@huggingface/transformers": "^4.2.0",
    "@workspace/aegis-core": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.5.0",
    "multer": "2.2.0",
    "onnxruntime-node": "^1.24.3",
    "optional": "^0.1.4",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "pino": "^9",
    "pino-http": "^10",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pdf-parse": "^2.4.5",
    "pino-pretty": "^13",
    "tesseract.js": "^7.0.0",
    "thread-stream": "3.1.0"
  }
}
