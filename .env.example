# TancMark Live local core
TANCMARK_LIVE_STORAGE_ROOT=<dedicated-absolute-storage-directory>
TANCMARK_LIVE_PLAYBACK_KEYRING={"activeKid":"replace-me","keys":{"replace-me":"base64:<at-least-32-random-bytes>"}}
TANCMARK_LIVE_LOCAL_TENANT_ID=<verified-local-tenant-id>
ADMIN_TOKEN=<at-least-16-random-characters>

# In-stream Video Primary runtime (install locally; binaries are not bundled)
TANCMARK_LIVE_WATERMARK_PYTHON=<absolute-path-to-verified-python>
TANCMARK_LIVE_WATERMARK_WORKER_SCRIPT=<absolute-path-to-live_streaming_adapter_worker.py>
TANCMARK_LIVE_ADAPTER_C_SCRIPT=<absolute-path-to-unified_pts_watermark_adapter_c.py>
TANCMARK_LIVE_WATERMARK_TIMEOUT_MS=600000
TANCMARK_LIVE_WATERMARK_MAX_QUEUE=2

# Conservative optional storage limits
TANCMARK_LIVE_MAX_SESSION_BYTES=10737418240
TANCMARK_LIVE_MAX_SESSION_SEGMENTS=100000
TANCMARK_LIVE_MAX_SESSION_DURATION_MS=86400000
TANCMARK_LIVE_MIN_FREE_BYTES=1073741824

# External providers are intentionally not enabled by the local core.
# Configure an adapter outside this file using config/live-external-providers.schema.json
# and an opaque credentialReference owned by your secret store. Never paste raw
# OAuth tokens, stream keys, API keys or passwords into this repository.

# C2PA provenance support. Remote manifests remain disabled.
C2PA_REMOTE_MANIFEST_FETCH=false
TANCMARK_C2PA_TENANT_ROOTS_JSON={"verified-tenant-id":"<absolute-dedicated-working-copy-directory>"}
TANCMARK_C2PA_SIGNING_ENABLED=0
# Per-tenant 32-byte-or-longer base64url HMAC keys. These create stable,
# non-enumerable public registry handles; rotate only with an operator migration.
TANCMARK_C2PA_REGISTRY_REFERENCE_HMAC_KEYS_JSON={"verified-tenant-id":"<base64url-secret-at-least-32-bytes>"}
# When explicitly enabled, configure certificate/private-key file paths supplied
# by the operator secret-management boundary. Never commit real paths or key data.
TANCMARK_C2PA_SIGNING_PROFILES_JSON={"verified-tenant-id":{"certificatePath":"<absolute-certificate-path>","privateKeyPath":"<absolute-private-key-path>","algorithm":"es256"}}
